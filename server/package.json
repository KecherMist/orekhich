{
  "name": "orekhich-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Орехич — бэкенд магазина орехов: товары, корзина-заказы, промокоды, отзывы, админ-панель (SQLite + Express)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/db.js --reseed",
    "test": "node --test --test-reporter=spec test/*.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  }
}
